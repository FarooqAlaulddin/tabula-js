{
	"private": true,
	"scripts": {
		"build": "pnpm -r build",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "pnpm -r typecheck",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"clean": "pnpm -r clean",
		"test:e2e": "pnpm build && playwright test --config e2e/playwright.config.ts",
		"demo": "pnpm build && vite --config demo/vite.config.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"@playwright/test": "^1.58.2",
		"@vitest/coverage-v8": "^3.2.4",
		"typescript": "^5.7.0",
		"vitest": "^3.0.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": ["@biomejs/biome", "esbuild"]
	}
}
