{
	"name": "@farooqalaulddin/tabula-js",
	"version": "0.1.0",
	"description": "Coordinate browser tabs as views of a single workspace",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/FarooqAlaulddin/tabula-js.git",
		"directory": "packages/tabula"
	},
	"homepage": "https://github.com/FarooqAlaulddin/tabula-js#readme",
	"bugs": {
		"url": "https://github.com/FarooqAlaulddin/tabula-js/issues"
	},
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./testing": {
			"import": {
				"types": "./dist/testing.d.ts",
				"default": "./dist/testing.js"
			},
			"require": {
				"types": "./dist/testing.d.cts",
				"default": "./dist/testing.cjs"
			}
		}
	},
	"files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist"
	},
	"devDependencies": {
		"tsup": "^8.0.0"
	},
	"keywords": [
		"tabs",
		"browser-tabs",
		"broadcast-channel",
		"web-locks",
		"multi-tab",
		"multi-window",
		"coordination",
		"workspace",
		"shared-state",
		"leader-election",
		"browser"
	],
	"engines": {
		"node": ">=20"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false
}
