{
	"name": "tabula-react",
	"version": "0.1.0",
	"description": "React bindings for Tabula — coordinate browser tabs as views of a single workspace",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": ["dist"],
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"tabula": "workspace:*"
	},
	"devDependencies": {
		"@types/react": "^19.0.0",
		"react": "^19.0.0",
		"tabula": "workspace:*",
		"tsup": "^8.0.0"
	},
	"license": "MIT",
	"sideEffects": false
}
